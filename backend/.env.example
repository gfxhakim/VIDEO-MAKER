# ---------- Core ----------
# Where uploads, renders and the SQLite DB are stored
DATA_DIR=./data
# Public URL of this API. Instagram/Facebook fetch videos from it, and OAuth
# redirect URIs are built from it. Use an https tunnel (ngrok/cloudflared) for IG.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Used to encrypt OAuth tokens at rest. Change it! (any long random string)
APP_SECRET_KEY=change-me-to-a-long-random-string

# ---------- Worker ----------
# true = run the job worker + publish scheduler inside the API process (easy dev)
EMBEDDED_WORKER=true
# How many render jobs run in parallel. 1 keeps a laptop responsive.
WORKER_CONCURRENCY=1
# FFmpeg x264 preset: ultrafast|veryfast|fast|medium|slow  (slower = smaller file, same quality)
FFMPEG_PRESET=veryfast
FFMPEG_CRF=18
FFMPEG_THREADS=0

# ---------- Transcription ----------
# local       = faster-whisper on this machine (CPU int8 by default)
# openai      = OpenAI whisper-1 API (needs OPENAI_API_KEY)
# groq        = Groq whisper-large-v3 API, has a free tier (needs GROQ_API_KEY)
# none        = skip speech, score by audio energy only (fast test mode)
TRANSCRIBE_BACKEND=local
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OPENAI_API_KEY=
GROQ_API_KEY=

# ---------- Publishing (fill in from your own developer apps; see docs/PUBLISHING.md) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Dry run: pretend to publish (logs + fake ids) so you can test the queue safely
PUBLISH_DRY_RUN=false
