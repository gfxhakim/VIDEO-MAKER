# Everything is optional. No API keys are needed anywhere.

# Where uploads, renders, the database and the Whisper model live.
# On Railway this is the volume mount path (/data).
DATA_DIR=./data

# Signs login sessions. Leave empty to auto-generate one into DATA_DIR/secret.key.
APP_SECRET_KEY=

# Allow new visitors to create accounts freely (can also be toggled live in the Admin Panel).
ALLOW_SIGNUP=true

# Optional bootstrap admin account (recommended on Railway Variables so you control exact credentials).
# If left empty on a fresh deploy, one-time credentials are generated into DATA_DIR/admin_credentials.txt and logged at boot.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=change-me-strong-password
# ADMIN_NAME=Admin

# ---------- Processing ----------
# Whisper model: tiny (fastest) | base (default) | small | medium (most accurate, slow on CPU)
WHISPER_MODEL=base
# local = transcribe on this machine, none = skip speech (energy-only scoring)
TRANSCRIBE_BACKEND=local
# Clips rendered in parallel. 0 = decide from the CPU cores and memory this server has
# (1 below 4 cores or 4 GB, up to 3 on bigger machines). Set a number to force it.
WORKER_CONCURRENCY=0
# Threads for the speech model. 0 = 2 on servers up to 4 cores, 4 on bigger ones.
WHISPER_THREADS=0
# x264 speed: ultrafast|veryfast|fast|medium. Slower = smaller file, same quality.
FFMPEG_PRESET=veryfast
# Quality: lower = better and bigger. 21 looks the same as 18 on a phone at 2/3 of the size.
FFMPEG_CRF=21
# Only if the server reports more CPU cores than your plan really gives you.
# CPU_LIMIT=2
# Download OpenCV YuNet face detection model on first run (falls back to Haar if false/offline)
AUTO_DOWNLOAD_YUNET=true

# ---------- Optional AI (Ollama / OpenAI-compatible, off by default) ----------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.2

# ---------- URL Ingestion Limits ----------
YTDLP_MAX_FILESIZE_GB=4.0
ALLOW_PRIVATE_URLS=false
# Optional Netscape-format cookies.txt content or file path for authenticated URL imports (YouTube etc.):
# YTDLP_COOKIES_FILE=/data/ytdlp_cookies.txt
# YTDLP_COOKIES=

# Dev only: origin of `npm run dev`
CORS_ORIGINS=http://localhost:3000
