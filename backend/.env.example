# Everything is optional. No API keys are needed anywhere.

# Where uploads, renders, the database and the Whisper model live.
# On Railway this is the volume mount path (/data).
DATA_DIR=./data

# Signs login sessions. Leave empty to auto-generate one into DATA_DIR/secret.key.
APP_SECRET_KEY=

# Let more people create accounts after the first (owner) account.
ALLOW_SIGNUP=false

# ---------- Processing ----------
# Whisper model: tiny (fastest) | base (default) | small | medium (most accurate, slow on CPU)
WHISPER_MODEL=base
# local = transcribe on this machine, none = skip speech (energy-only scoring)
TRANSCRIBE_BACKEND=local
# Clips rendered in parallel. Keep 1 on small servers (Railway Hobby), 2-3 on bigger ones.
WORKER_CONCURRENCY=1
# x264 speed: ultrafast|veryfast|fast|medium. Slower = smaller file, same quality.
FFMPEG_PRESET=veryfast
FFMPEG_CRF=18

# Dev only: origin of `npm run dev`
CORS_ORIGINS=http://localhost:3000
